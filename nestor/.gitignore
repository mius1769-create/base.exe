# Локальные данные NeSToR: пользовательская база и серверный секрет — никогда не в git
var/
*.db
*.db-wal
*.db-shm
*.key
# Научный справочник кладётся локально; в git — только MANIFEST.json после сверки
data/*.db
# синтетические файлы форматов (не данные): tests/fixtures/formats/README.txt
!tests/fixtures/formats/*.xlsx
# сборка NeSToR.exe (PyInstaller) — только в CI, не в git
dist/
build/
*.spec
